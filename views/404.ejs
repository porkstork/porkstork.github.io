<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<%#404 error page styled with Bootstrap%>
<body class="bg-light">
    <div class="container text-center py-5">

        <div class="mt-5">
            <h1 class="display-1 fw-bold text-info">404</h1>
            <h2 class="mb-3">Page Not Found</h2>
            <%#header and paragraph tags explaining page wasnt found%>
            <p class="lead text-muted mb-4">
                The page you are looking for may have been moved, deleted, or never existed.
            </p>
            <%#Home button that takes the user back to the root main screen which would be index.ejs as routed%>
            <a href="/" class="btn btn-info text-white px-4">
                Return Home
            </a>
        </div>
    </div>
</body>
</html>